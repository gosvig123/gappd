{
  "name": "gappd-desktop",
  "version": "0.1.7",
  "private": true,
  "description": "Desktop app for gappd",
  "author": "gappd",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "npm run dev:prepare && npm run dev:start",
    "dev:reset-local-ai-setup": "node ./scripts/reset-dev-local-ai-setup.mjs",
    "dev:prepare": "npm run prepare:llamacpp && npm run prepare:ffmpeg && npm run native:prepare -- dev",
    "dev:start": "node ./scripts/dev-runtime-assets.mjs && concurrently -k \"vite\" \"tsup --config tsup.config.ts --watch\" \"wait-on tcp:127.0.0.1:${GAPPD_UI_VITE_PORT:-5173} dist-electron/main/main.js && VITE_DEV_SERVER_URL=http://127.0.0.1:${GAPPD_UI_VITE_PORT:-5173} electron .\"",
    "build": "npm run build:renderer && npm run native:prepare -- build && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsup --config tsup.config.ts",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts' 'scripts/*.test.cjs'",
    "typecheck": "tsc --noEmit",
    "preflight:macos": "node ./scripts/preflight-macos.mjs",
    "native:prepare": "node ./scripts/ensure-native-artifacts.mjs",
    "prepare:llamacpp": "node ./scripts/prepare-llamacpp-bundle.mjs",
    "prepare:ffmpeg": "node ./scripts/prepare-ffmpeg-bundle.mjs",
    "dist": "npm run prepare:llamacpp && npm run prepare:ffmpeg && npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:dir": "npm run dist -- --mac dir",
    "dist:mac:universal": "GAPPD_MAC_BUILD=universal npm run dist -- --mac --universal",
    "install:mac": "node ./scripts/install-mac-build.cjs",
    "verify:mac-release": "node ./scripts/verify-mac-release.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^1.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
